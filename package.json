{
  "name": "brainpop-playwright",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Playwright Test + Gherkin (playwright-bdd) framework for BrainPOP",
  "scripts": {
    "gen": "node scripts/clean-reports.js && bddgen",
    "test": "npm run gen && playwright test",
    "test:e2e": "npm test",
    "test:smoke": "npm run gen && playwright test --grep @smoke",
    "test:a11y": "npm run gen && playwright test --grep @a11y",
    "test:ci": "npm run gen && playwright test --grep-invert \"@failing|@visual|@known-issue\"",
    "test:demo-failures": "npm run gen && playwright test --grep \"@failing\"",
    "test:mobile": "cross-env MOBILE=1 npm run gen && playwright test --grep-invert \"@failing|@visual|@known-issue\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.7.2"
  }
}

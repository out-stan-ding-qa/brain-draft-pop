# Target environment: dev | staging | prod
# URLs come from test-data/<ENV>/env.json
ENV=dev

# Optional URL overrides (leave unset to use the env.json for ENV)
# BASE_URL=https://www.brainpop.com/login/
# API_BASE_URL=https://api.brainpop.com

# Optional account overrides — the account comes from test-data/<ENV>/env.json.
# Set these to run against your own account without editing the env config.
# BP_USERNAME=qatest2026
# BP_PASSWORD=brainp0p
# BP_ACCOUNT_NAME=QA

# Playwright runtime
# WORKERS=4
# RETRIES=0

# Extra device project (iPhone 13) when set to 1
MOBILE=0

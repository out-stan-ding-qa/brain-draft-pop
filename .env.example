# Target environment: dev | staging | prod
ENV=dev

# AUT origin (login page is the default)
BASE_URL=https://www.brainpop.com/login/

# Authentication API used by the login page
API_BASE_URL=https://api.brainpop.com

# Shared QA account — copy this file to .env (gitignored)
BP_USERNAME=qatest2026
BP_PASSWORD=brainp0p

# Playwright runtime
# WORKERS=4
# RETRIES=0

# Extra device project (iPhone 13) when set to 1
MOBILE=0

# none | selenium | browserstack | lambdatest (scaffold; CI stays local)
REMOTE_PROVIDER=none
# REMOTE_WS_ENDPOINT=wss://your-grid/playwright
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# LAMBDATEST_USERNAME=
# LAMBDATEST_ACCESS_KEY=

# Optional Lighthouse in CI/local (not enabled by default)
PERF_LIGHTHOUSE=0

# Notifications (CI skips unless set)
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
